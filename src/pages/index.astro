---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerStrip from '../components/CareerStrip.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SkillTrace from '../components/SkillTrace.astro';
import profileImage from '../assets/profile.jpg';
import { AUTHOR, CV_PDF, SITE_DESCRIPTION, SOCIALS } from '../consts';
import { EDUCATION } from '../data/education';
import { SKILLS } from '../data/skills';
import { getJobs, tenureOf } from '../utils/career';
import { formatSpan, monthsBetween, yearsSince } from '../utils/date';
import { occupationRole, personId } from '../utils/schema';

const jobs = await getJobs();

const currentJob = jobs.find((job) => job.data.date_end === 'present');
const age = yearsSince(new Date(AUTHOR.birthMonth));

// Everything time-based is computed at build; the deploy workflow rebuilds monthly.
const careerStart = jobs.at(-1)!.data.date_start;
const careerMonths = monthsBetween(careerStart, new Date());
const careerYears = yearsSince(careerStart);

// Handles, not full URLs, so the rows fit the sidebar.
const contact = [
  { label: 'email', href: `mailto:${AUTHOR.email}`, text: AUTHOR.email },
  ...SOCIALS.map((social) => ({
    label: social.label.toLowerCase(),
    href: social.href,
    text: new URL(social.href).pathname.slice(1),
  })),
];

const resumeSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': personId(Astro.site!),
    name: AUTHOR.name,
    jobTitle: AUTHOR.jobTitle,
    homeLocation: { '@type': 'Place', name: AUTHOR.location },
    knowsAbout: SKILLS,
    hasOccupation: jobs.map(occupationRole),
    ...(currentJob && {
      worksFor: {
        '@type': 'Organization',
        name: currentJob.data.company,
        ...(currentJob.data.companyUrl && { url: currentJob.data.companyUrl }),
      },
    }),
    alumniOf: EDUCATION.map((entry) => ({
      '@type': 'EducationalOrganization',
      name: entry.institution,
      ...(entry.url && { url: entry.url }),
    })),
  },
};
---

<BaseLayout
  title={`${AUTHOR.name} — ${AUTHOR.jobTitle}`}
  description={SITE_DESCRIPTION}
  fullTitle
  schema={[resumeSchema]}
>
  <header class="hero">
    <Image
      src={profileImage}
      alt={`Portrait of ${AUTHOR.name}`}
      class="portrait"
      loading="eager"
      fetchpriority="high"
      widths={[120, 240]}
      sizes="120px"
    />
    <div class="identity">
      <h1>{AUTHOR.name}</h1>
      {
        currentJob && (
          <p class="status">
            <span class="status-dot" aria-hidden="true" />
            {currentJob.data.role} · {currentJob.data.company}
          </p>
        )
      }
      <p class="meta">
        <span>
          {AUTHOR.location} — <span data-local-time>UTC−5</span>
        </span>
        <span class="sep" aria-hidden="true">/</span>
        {
          SOCIALS.map((social) => (
            <a href={social.href} target="_blank" rel="me noopener noreferrer">
              {social.label.toLowerCase()}
            </a>
          ))
        }
      </p>
    </div>
  </header>

  <section class="intro prose">
    <p>
      Hello 👋, I'm <strong>Esteban</strong>, a senior software engineer living in Colombia 🇨🇴. I've
      spent {careerYears}+ years building products with Ruby on Rails: from one of the first 4
      engineers (and later tech lead) at a startup that grew to ~30 engineers, to fintech platforms
      for retirement plans and subscription billing. These days I also build AI tooling (MCP
      servers, agents, Claude Code skills) into how I ship software.
    </p>
    <p>
      I'm {age} years old, a Ruby/Ruby on Rails lover; Ruby is my main programming language, but I
      like JavaScript as well (in fact, this resume has been built with JavaScript).
    </p>
    <p>
      I enjoy reading and watching movies, series and anime. I like to have a few beers once in a
      while as well :)
    </p>
  </section>

  <div class="columns">
    <div class="main-col">
      <h2 class="section-head">Skills</h2>
      <SkillTrace jobs={jobs} />

      <h2 class="section-head section-head--gap">
        Experience <span class="section-aside">{formatSpan(careerMonths)} and counting</span>
      </h2>

      <div class="career">
        <CareerStrip jobs={jobs} />
      </div>

      <ol class="timeline">
        {
          jobs.map((job) => {
            const isCurrent = job.data.date_end === 'present';
            return (
              <li class="node" data-job={job.id}>
                <a href={`/jobs/${job.id}/`}>
                  <span class="rail" aria-hidden="true">
                    <span class="rail-line rail-line--top" />
                    <span class:list={['dot', { 'dot--current': isCurrent }]} />
                    <span class="rail-line rail-line--bottom" />
                  </span>
                  <span class="entry">
                    <span class="period">
                      <FormattedDate date={job.data.date_start} format="short" />
                      {' — '}
                      <FormattedDate date={job.data.date_end} format="short" />
                      <span class="tenure">{formatSpan(tenureOf(job))}</span>
                    </span>
                    <span class="role">{job.data.role}</span>
                    <span class="company">{job.data.company}</span>
                    {job.data.summary && <span class="summary">{job.data.summary}</span>}
                  </span>
                  <svg
                    class="arrow"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>

    <aside class="side">
      <h2 class="section-head">Education</h2>
      <ul class="education">
        {
          EDUCATION.map((entry) => (
            <li>
              <span class="period">{entry.period}</span>
              <span class="degree">
                {entry.url ? (
                  <a href={entry.url} target="_blank" rel="noopener noreferrer">
                    {entry.title}
                  </a>
                ) : (
                  entry.title
                )}
              </span>
              <span class="institution">{entry.institution}</span>
            </li>
          ))
        }
      </ul>

      <h2 class="section-head section-head--gap">Contact</h2>
      <dl class="contact">
        {
          contact.map(({ label, href, text }) => (
            <div>
              <dt>{label}</dt>
              <dd>
                {href.startsWith('mailto:') ? (
                  <a href={href}>{text}</a>
                ) : (
                  <a href={href} target="_blank" rel="me noopener noreferrer">
                    {text}
                  </a>
                )}
              </dd>
            </div>
          ))
        }
        <div>
          <dt>cv</dt>
          <dd>
            <a href={CV_PDF} download data-astro-prefetch="false">download pdf</a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</BaseLayout>

<script>
  // Local time in Colombia, so visitors know whether I'm likely awake.
  const clock = document.querySelector<HTMLElement>('[data-local-time]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/Bogota',
    });
    const tick = () => (clock.textContent = `${format.format(new Date())} here`);
    tick();
    setInterval(tick, 30_000);
  }

  // Hovering or focusing a role lights up its stretch of the career strip.
  const strip = document.querySelector('.strip');
  document.querySelectorAll<HTMLElement>('.node[data-job]').forEach((node) => {
    const seg = strip?.querySelector(`.seg[data-job="${node.dataset.job}"]`);
    const on = () => seg?.classList.add('is-active');
    const off = () => seg?.classList.remove('is-active');
    node.addEventListener('mouseenter', on);
    node.addEventListener('mouseleave', off);
    node.addEventListener('focusin', on);
    node.addEventListener('focusout', off);
  });
</script>

<style>
  /*
    Resume shell: a display-scale name over a two-column grid — skills and the
    experience timeline on the left, education and contact in a sticky sidebar.
    Section heads are sentence-case with a hairline, never wide-tracked eyebrows.
  */
  .hero {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  .portrait {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    object-fit: cover;
    object-position: center top;
    border-radius: 2px;
    border: 1px solid var(--line);
    filter: grayscale(1) contrast(1.05);
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-top: 0.125rem;
    min-width: 0;
  }

  .identity h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    margin: 0;
    font-size: 0.875rem;
    color: var(--text);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--accent);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .meta a {
    color: var(--muted);
    text-decoration: none;
  }

  .meta a:hover {
    color: var(--accent);
  }

  .sep {
    color: var(--line);
  }

  .intro {
    max-width: 38rem;
    margin: 0 0 3.5rem;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 3.5rem;
    align-items: start;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .section-head::after {
    content: '';
    flex-grow: 1;
    order: 1;
    height: 1px;
    background: var(--line);
  }

  .section-aside {
    order: 2;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
  }

  .section-head--gap {
    margin-top: 2.5rem;
  }

  .career {
    margin: 1.25rem 0 0.75rem;
  }

  .tenure {
    margin-left: 0.625rem;
    padding-left: 0.625rem;
    border-left: 1px solid var(--line);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .node {
    transition: opacity 0.18s ease;
  }

  /* Set by SkillTrace. */
  .node.is-dimmed {
    opacity: 0.35;
  }

  .node a {
    display: flex;
    gap: 1.25rem;
    align-items: stretch;
    color: inherit;
    text-decoration: none;
  }

  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 12px;
    flex-shrink: 0;
  }

  .rail-line {
    width: 1px;
    background: var(--line);
  }

  .rail-line--top {
    height: 1.5rem;
  }

  .rail-line--bottom {
    flex-grow: 1;
  }

  /* The first node has no line above it and the last none below. */
  .node:first-child .rail-line--top,
  .node:last-child .rail-line--bottom {
    background: transparent;
  }

  .dot {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--line);
    /* Breaks the rail behind the dot so it reads as a marker, not a bead. */
    outline: 3px solid var(--bg);
    transition: background 0.18s ease;
  }

  .dot--current {
    background: var(--accent);
  }

  .entry {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1rem 0 1.625rem;
  }

  .period {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.4375rem;
  }

  .role {
    font-size: 0.9375rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
    transition: color 0.18s ease;
  }

  .company {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* The one-line impact summary, so the timeline reads without clicking into each role. */
  .summary {
    margin-top: 0.625rem;
    max-width: 34rem;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text);
  }

  .arrow {
    align-self: center;
    flex-shrink: 0;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .node a:hover .dot {
    background: var(--accent);
  }

  .node a:hover .role {
    color: var(--accent);
  }

  .node a:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .education {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .education li {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--line);
  }

  .education li:first-child {
    border-top: 1px solid var(--line);
  }

  .education .period {
    margin-bottom: 0.125rem;
  }

  .degree {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .degree a {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .degree a:hover {
    color: var(--accent);
  }

  .institution {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .contact {
    margin: 0;
    font-size: 0.75rem;
  }

  .contact div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .contact div:first-child {
    border-top: 1px solid var(--line);
  }

  .contact dt {
    color: var(--muted);
  }

  .contact dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (min-width: 721px) {
    .side {
      position: sticky;
      top: 5.5rem;
    }
  }

  @media (max-width: 720px) {
    .hero {
      gap: 1.25rem;
    }

    .portrait {
      width: 88px;
      height: 88px;
    }

    .columns {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }
</style>
