---
import Layout from '../layouts/Layout.astro';
import DateFormatter from '../components/Date.astro';
import { getCollection } from 'astro:content';

const allJobsData = await getCollection('jobs');

// Sort jobs by start date (newest first)
const sortedJobs = allJobsData.sort((a, b) => {
	const dateA = new Date(a.data.date_start);
	const dateB = new Date(b.data.date_start);
	return dateB.getTime() - dateA.getTime();
});

const siteTitle = "Esteban's Resume";
---

<Layout title={siteTitle} home={true}>
	<section class="headingMd">
		<p>Hello 👋, I'm <strong>Esteban</strong>, I'm a software engineer, I live in Colombia 🇨🇴.</p>
		<p>I'm 25 years old, a Ruby/Ruby on Rails lover; Ruby is my main programming language but, I like JavaScript as well (In fact, this resume has been built with JavaScript).</p>
		<p>I'm studying English, I enjoy reading, watching movies/series/animes. I like to have a few beers once in a while as well :) </p>
	</section>

	<section class="headingMd padding1px">
		<h2 class="headingLg">Experience</h2>
		<ul class="list">
			{
				sortedJobs.map((job) => (
					<li class="listItem">
						<a href={`/jobs/${job.id}`}>{job.data.title}</a>
						<br />
						<small class="lightText">
							<DateFormatter dateString={job.data.date_start}/> - <DateFormatter dateString={job.data.date_end}/>
						</small>
					</li>
				))
			}
		</ul>
	</section>

	<section class="headingMd padding1px">
		<h2 class="headingLg">Education</h2>
      <a href="https://senacertificados.co/analisis-desarrollo-de-sistemas-de-informacion/" target="_blank" rel="noopener noreferrer">Análisis y Desarrollo de Sistemas de información</a>
		<br />
		<small>SENA</small>
		<br />
		<small class="lightText">September, 2017 - September, 2019</small>
	</section>
</Layout>

<style is:inline>
	.headingMd {
		font-size: 1.2rem;
		line-height: 1.5;
	}

	.headingLg {
		font-size: 1.5rem;
		line-height: 1.4;
		margin: 1rem 0;
	}

	.padding1px {
		padding-top: 1px;
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.listItem {
		margin: 0 0 1.25rem;
	}

	.lightText {
		color: var(--text-primary);
	}

	a {
		color: var(--accent);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}
</style>
