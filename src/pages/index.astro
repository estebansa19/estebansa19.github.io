---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import profileImage from '../assets/profile.jpg';
import { AUTHOR, SITE_DESCRIPTION, SOCIALS } from '../consts';
import { EDUCATION } from '../data/education';
import { SKILLS } from '../data/skills';
import { toISODate, yearsSince } from '../utils/date';

const jobs = (await getCollection('jobs')).sort(
	(a, b) => b.data.date_start.getTime() - a.data.date_start.getTime(),
);

const currentJob = jobs.find((job) => job.data.date_end === 'present');
const age = yearsSince(new Date(AUTHOR.birthDate));

const resumeSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	mainEntity: {
		'@type': 'Person',
		name: AUTHOR.name,
		jobTitle: AUTHOR.jobTitle,
		homeLocation: { '@type': 'Place', name: AUTHOR.location },
		knowsAbout: SKILLS,
		hasOccupation: jobs.map((job) => ({
			'@type': 'Occupation',
			name: job.data.role,
			occupationLocation: { '@type': 'Organization', name: job.data.company },
			startDate: toISODate(job.data.date_start),
			...(job.data.date_end !== 'present' && { endDate: toISODate(job.data.date_end) }),
		})),
		alumniOf: EDUCATION.map((entry) => ({
			'@type': 'EducationalOrganization',
			name: entry.institution,
			...(entry.url && { url: entry.url }),
		})),
	},
};
---

<BaseLayout
	title={`${AUTHOR.name} — ${AUTHOR.jobTitle}`}
	description={SITE_DESCRIPTION}
	fullTitle
	schema={[resumeSchema]}
>
	<header class="hero">
		<Image
			src={profileImage}
			alt={`Portrait of ${AUTHOR.name}`}
			class="portrait"
			loading="eager"
			fetchpriority="high"
			widths={[120, 240]}
			sizes="120px"
		/>
		<div class="identity">
			<h1>{AUTHOR.name}</h1>
			{
				currentJob && (
					<p class="status">
						<span class="status-dot" aria-hidden="true" />
						{currentJob.data.role} · {currentJob.data.company}
					</p>
				)
			}
			<p class="meta">
				<span>{AUTHOR.location} — UTC−5</span>
				<span class="sep" aria-hidden="true">/</span>
				{
					SOCIALS.map((social) => (
						<a href={social.href} target="_blank" rel="me noopener noreferrer">
							{social.label.toLowerCase()}
						</a>
					))
				}
			</p>
		</div>
	</header>

	<section class="intro prose">
		<p>Hello 👋, I'm <strong>Esteban</strong>, I'm a software engineer, I live in Colombia 🇨🇴.</p>
		<p>
			I'm {age} years old, a Ruby/Ruby on Rails lover; Ruby is my main programming language but, I
			like JavaScript as well (in fact, this resume has been built with JavaScript).
		</p>
		<p>
			I enjoy reading, watching movies/series/animes. I like to have a few beers once in a while as
			well :)
		</p>
	</section>

	<div class="columns">
		<div class="main-col">
			<h2 class="section-head">Experience</h2>

			<ol class="timeline">
				{
					jobs.map((job) => {
						const isCurrent = job.data.date_end === 'present';
						return (
							<li class="node">
								<a href={`/jobs/${job.id}/`}>
									<span class="rail" aria-hidden="true">
										<span class="rail-line rail-line--top" />
										<span class:list={['dot', { 'dot--current': isCurrent }]} />
										<span class="rail-line rail-line--bottom" />
									</span>
									<span class="entry">
										<span class="period">
											<FormattedDate date={job.data.date_start} format="short" />
											{' — '}
											<FormattedDate date={job.data.date_end} format="short" />
										</span>
										<span class="role">{job.data.role}</span>
										<span class="company">{job.data.company}</span>
									</span>
									<svg
										class="arrow"
										width="14"
										height="14"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M5 12h14M13 6l6 6-6 6" />
									</svg>
								</a>
							</li>
						);
					})
				}
			</ol>
		</div>

		<aside class="side">
			<h2 class="section-head">Skills</h2>
			<ul class="chips">
				{SKILLS.map((skill) => <li>{skill}</li>)}
			</ul>

			<h2 class="section-head section-head--gap">Education</h2>
			<ul class="education">
				{
					EDUCATION.map((entry) => (
						<li>
							<span class="period">{entry.period}</span>
							<span class="degree">
								{entry.url ? (
									<a href={entry.url} target="_blank" rel="noopener noreferrer">
										{entry.title}
									</a>
								) : (
									entry.title
								)}
							</span>
							<span class="institution">{entry.institution}</span>
						</li>
					))
				}
			</ul>
		</aside>
	</div>
</BaseLayout>

<style>
	/*
		Resume shell: a display-scale name over a two-column grid — experience
		timeline on the left, skills and education in a sticky sidebar. Section
		heads are sentence-case with a hairline, never wide-tracked eyebrows.
	*/
	.hero {
		display: flex;
		align-items: flex-start;
		gap: 1.75rem;
		margin-bottom: 3rem;
	}

	.portrait {
		width: 120px;
		height: 120px;
		flex-shrink: 0;
		object-fit: cover;
		object-position: center top;
		border-radius: 2px;
		border: 1px solid var(--line);
		filter: grayscale(1) contrast(1.05);
	}

	.identity {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		padding-top: 0.125rem;
		min-width: 0;
	}

	.identity h1 {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.status {
		display: flex;
		align-items: center;
		gap: 0.5625rem;
		margin: 0;
		font-size: 0.875rem;
		color: var(--text);
	}

	.status-dot {
		width: 7px;
		height: 7px;
		flex-shrink: 0;
		border-radius: 999px;
		background: var(--accent);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		flex-wrap: wrap;
		margin: 0;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.meta a {
		color: var(--muted);
		text-decoration: none;
	}

	.meta a:hover {
		color: var(--accent);
	}

	.sep {
		color: var(--line);
	}

	.intro {
		max-width: 38rem;
		margin: 0 0 3.5rem;
	}

	.intro p:last-child {
		margin-bottom: 0;
	}

	.columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 15rem;
		gap: 3.5rem;
		align-items: start;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin: 0 0 0.5rem;
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.section-head::after {
		content: '';
		flex-grow: 1;
		height: 1px;
		background: var(--line);
	}

	.section-head--gap {
		margin-top: 2.5rem;
	}

	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.node a {
		display: flex;
		gap: 1.25rem;
		align-items: stretch;
		color: inherit;
		text-decoration: none;
	}

	.rail {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 12px;
		flex-shrink: 0;
	}

	.rail-line {
		width: 1px;
		background: var(--line);
	}

	.rail-line--top {
		height: 1.5rem;
	}

	.rail-line--bottom {
		flex-grow: 1;
	}

	/* The first node has no line above it and the last none below. */
	.node:first-child .rail-line--top,
	.node:last-child .rail-line--bottom {
		background: transparent;
	}

	.dot {
		width: 9px;
		height: 9px;
		flex-shrink: 0;
		border-radius: 999px;
		background: var(--line);
		/* Breaks the rail behind the dot so it reads as a marker, not a bead. */
		outline: 3px solid var(--bg);
		transition: background 0.18s ease;
	}

	.dot--current {
		background: var(--accent);
	}

	.entry {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		padding: 1rem 0 1.625rem;
	}

	.period {
		font-size: 0.75rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		margin-bottom: 0.4375rem;
	}

	.role {
		font-size: 0.9375rem;
		font-weight: 500;
		margin-bottom: 0.25rem;
		transition: color 0.18s ease;
	}

	.company {
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.arrow {
		align-self: center;
		flex-shrink: 0;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 0.18s ease,
			transform 0.18s ease;
	}

	.node a:hover .dot {
		background: var(--accent);
	}

	.node a:hover .role {
		color: var(--accent);
	}

	.node a:hover .arrow {
		opacity: 1;
		transform: translateX(0);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.chips li {
		font-size: 0.75rem;
		line-height: 1;
		padding: 0.4rem 0.55rem;
		border: 1px solid var(--line);
		border-radius: 2px;
		color: var(--text);
	}

	.education {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.education li {
		display: flex;
		flex-direction: column;
		gap: 0.1875rem;
		padding: 0.875rem 0;
		border-bottom: 1px solid var(--line);
	}

	.education li:first-child {
		border-top: 1px solid var(--line);
	}

	.education .period {
		margin-bottom: 0.125rem;
	}

	.degree {
		font-size: 0.8125rem;
		font-weight: 500;
	}

	.degree a {
		color: inherit;
		text-decoration: none;
		transition: color 0.18s ease;
	}

	.degree a:hover {
		color: var(--accent);
	}

	.institution {
		font-size: 0.75rem;
		color: var(--muted);
	}

	@media (min-width: 721px) {
		.side {
			position: sticky;
			top: 5.5rem;
		}
	}

	@media (max-width: 720px) {
		.hero {
			gap: 1.25rem;
		}

		.portrait {
			width: 88px;
			height: 88px;
		}

		.columns {
			grid-template-columns: 1fr;
			gap: 2.75rem;
		}
	}
</style>
