---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR, SITE_DESCRIPTION } from '../consts';
import { EDUCATION } from '../data/education';
import { yearsSince, toISODate } from '../utils/date';

const age = yearsSince(new Date(AUTHOR.birthDate));

const jobs = (await getCollection('jobs')).sort(
	(a, b) => b.data.date_start.getTime() - a.data.date_start.getTime(),
);

// Rich structured data for the resume: every role plus the schools.
const resumeSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	mainEntity: {
		'@type': 'Person',
		name: AUTHOR.name,
		jobTitle: AUTHOR.jobTitle,
		homeLocation: { '@type': 'Place', name: AUTHOR.location },
		hasOccupation: jobs.map((job) => ({
			'@type': 'Occupation',
			name: job.data.role,
			occupationLocation: { '@type': 'Organization', name: job.data.company },
			startDate: toISODate(job.data.date_start),
			...(job.data.date_end !== 'present' && { endDate: toISODate(job.data.date_end) }),
		})),
		alumniOf: EDUCATION.map((entry) => ({
			'@type': 'EducationalOrganization',
			name: entry.institution,
			...(entry.url && { url: entry.url }),
		})),
	},
};
---

<Layout title={`${AUTHOR.name} — ${AUTHOR.jobTitle}`} description={SITE_DESCRIPTION} home fullTitle schema={[resumeSchema]}>
	<section class="intro">
		<p>
			Hello 👋, I'm <strong>Esteban</strong>, I'm a software engineer, I live in Colombia 🇨🇴.
		</p>
		<p>
			I'm {age} years old, a Ruby/Ruby on Rails lover; Ruby is my main programming language but, I
			like JavaScript as well (in fact, this resume has been built with JavaScript).
		</p>
		<p>
			I'm studying English, I enjoy reading, watching movies/series/animes. I like to have a few
			beers once in a while as well :)
		</p>
	</section>

	<section>
		<h2>Experience</h2>
		<ul class="list">
			{
				jobs.map((job) => (
					<li class="card">
						<a href={`/jobs/${job.id}/`} class="card-link">
							<span class="role">{job.data.role}</span>
							<span class="company">{job.data.company}</span>
						</a>
						<p class="meta">
							<FormattedDate date={job.data.date_start} format="short" />
							{' — '}
							<FormattedDate date={job.data.date_end} format="short" />
						</p>
						{job.data.summary && <p class="summary">{job.data.summary}</p>}
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>Education</h2>
		<ul class="list">
			{
				EDUCATION.map((entry) => (
					<li class="card">
						{entry.url ? (
							<a href={entry.url} target="_blank" rel="noopener noreferrer">
								{entry.title}
							</a>
						) : (
							<span class="role">{entry.title}</span>
						)}
						<p class="meta">
							{entry.institution}
							{entry.period && <> · {entry.period}</>}
						</p>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.intro {
		font-size: 1.15rem;
		line-height: 1.6;
	}

	h2 {
		font-size: 1.5rem;
		line-height: 1.4;
		margin: 2.5rem 0 1rem;
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.card {
		margin: 0 0 1rem;
		padding: 1rem;
		background-color: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.card:hover {
		border-color: var(--accent);
	}

	.card-link {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}

	.role {
		font-weight: 600;
	}

	.company {
		color: var(--text-secondary);
	}

	.card-link:hover .company {
		color: inherit;
	}

	.meta {
		margin: 0.25rem 0 0;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.summary {
		margin: 0.5rem 0 0;
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
	}
</style>
