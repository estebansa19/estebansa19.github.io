---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { AUTHOR } from '../../consts';
import { getPosts } from '../../utils/content';

const posts = await getPosts();
---

<BaseLayout
	title="Blog"
	description={`Writing about software engineering, Ruby and the web by ${AUTHOR.name}.`}
>
	<h1>Blog</h1>

	{
		posts.length === 0 ? (
			<p class="empty">No posts yet — something is on the way.</p>
		) : (
			<ul class="posts">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<Image
									src={post.data.heroImage}
									alt=""
									widths={[360, 720]}
									sizes="(max-width: 720px) 100vw, 340px"
									loading="lazy"
								/>
							)}
							<h2 class="title">{post.data.title}</h2>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	h1 {
		font-size: 2.5rem;
		letter-spacing: -0.03em;
		margin-bottom: 2rem;
	}

	.empty {
		color: var(--text-muted);
	}

	.posts {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.posts a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.posts img {
		margin-bottom: 0.75rem;
		border-radius: 12px;
	}

	.title {
		font-size: 1.25rem;
		margin: 0;
		line-height: 1.3;
	}

	.date {
		margin: 0.25rem 0 0;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.posts a:hover .title {
		color: var(--accent);
	}
</style>
