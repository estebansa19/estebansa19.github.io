---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR, SOCIALS } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// og:image needs an absolute URL, so resolve the optimised asset up front.
const ogImage = heroImage
	? new URL((await getImage({ src: heroImage, format: 'jpg' })).src, Astro.site).toString()
	: undefined;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: { '@type': 'Person', name: AUTHOR.name },
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
	...(ogImage && { image: ogImage }),
};
---

<BaseLayout
	title={title}
	description={description}
	image={ogImage}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	schema={[schema]}
>
	<a href="/blog" class="back">
		<svg
			width="13"
			height="13"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M19 12H5M11 18l-6-6 6-6"></path>
		</svg>
		all posts
	</a>

	<article>
		<p class="meta">
			<FormattedDate date={pubDate} />
			{
				updatedDate && (
					<>
						<span class="rule" aria-hidden="true" />
						updated <FormattedDate date={updatedDate} />
					</>
				)
			}
		</p>

		<h1>{title}</h1>

		{
			heroImage && (
				<Image
					class="hero"
					src={heroImage}
					alt=""
					widths={[720, 1440]}
					sizes="(max-width: 760px) 100vw, 720px"
					loading="eager"
					fetchpriority="high"
				/>
			)
		}

		<hr />

		<div class="prose">
			<slot />
		</div>
	</article>

	<footer class="post-footer">
		<a href="/blog">← all posts</a>
		<div class="links">
			{
				SOCIALS.map((social) => (
					<a href={social.href} target="_blank" rel="me noopener noreferrer">
						{social.label.toLowerCase()}
					</a>
				))
			}
			<a href="/rss.xml">rss</a>
		</div>
	</footer>
</BaseLayout>

<style>
	article {
		max-width: 45rem;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: var(--muted);
		text-decoration: none;
		margin-bottom: 3rem;
	}

	.back:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.back svg {
		transition: transform 0.18s ease;
	}

	.back:hover svg {
		transform: translateX(-3px);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 1rem;
		font-size: 0.75rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.rule {
		width: 16px;
		height: 1px;
		background: var(--line);
	}

	h1 {
		margin: 0 0 2rem;
		font-size: 1.875rem;
	}

	.hero {
		width: 100%;
		margin-bottom: 2rem;
	}

	hr {
		margin: 0 0 2.5rem;
	}

	.post-footer {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 45rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		font-size: 0.8125rem;
	}

	.links {
		display: flex;
		gap: 1.5rem;
	}

	@media (max-width: 720px) {
		h1 {
			font-size: 1.5rem;
		}
	}
</style>
