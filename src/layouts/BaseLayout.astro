---
/**
 * The single <html> shell for the whole site. Every page renders through this
 * so <head>, header and footer are defined in exactly one place.
 */
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = ComponentProps<typeof BaseHead>;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Links are prefetched as they scroll into view — the whole site is a handful
  // of tiny static pages, so navigation becomes effectively instant. Started
  // here instead of through the `prefetch` config option, whose injected
  // script Astro always ships as a separate file; this one gets inlined.
  import { init } from 'astro/virtual-modules/prefetch.js';

  init({ prefetchAll: true, defaultStrategy: 'viewport' });
</script>
