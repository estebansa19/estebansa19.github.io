---
/** Resume-side layout: the profile header plus a narrow reading column. */
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import profileImage from '../assets/profile.jpg';
import { AUTHOR } from '../consts';

interface Props {
	title: string;
	description?: string;
	/** The home page shows the large portrait and an <h1>; inner pages a smaller, linked one. */
	home?: boolean;
	schema?: Record<string, unknown>[];
	fullTitle?: boolean;
}

const { title, description, home = false, schema, fullTitle } = Astro.props;
const alt = `Portrait of ${AUTHOR.name}`;
---

<BaseLayout title={title} description={description} schema={schema} fullTitle={fullTitle}>
	<div class="page">
		<header class="profile-header">
			{
				home ? (
					<>
						<Image
							src={profileImage}
							alt={alt}
							class="portrait"
							loading="eager"
							fetchpriority="high"
							widths={[300]}
							sizes="300px"
						/>
						<h1 class="name">{AUTHOR.name}</h1>
					</>
				) : (
					<>
						<a href="/" aria-label="Back to home">
							<Image
								src={profileImage}
								alt={alt}
								class="portrait portrait--small"
								loading="eager"
								widths={[250]}
								sizes="250px"
							/>
						</a>
						<p class="name name--small">
							<a href="/">{AUTHOR.name}</a>
						</p>
					</>
				)
			}
		</header>

		<slot />

		{
			!home && (
				<div class="back-to-home">
					<a href="/">← Back to home</a>
				</div>
			)
		}
	</div>
</BaseLayout>

<style>
	.page {
		max-width: 36rem;
		margin: 0 auto;
	}

	.profile-header {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.portrait {
		width: 300px;
		height: 250px;
		object-fit: cover;
		object-position: center top;
		border: 4px solid var(--border-color);
		border-radius: 12px;
		transition: border-color 0.2s ease;
	}

	.portrait:hover {
		border-color: var(--accent);
	}

	.portrait--small {
		width: 250px;
		height: 200px;
	}

	.name {
		font-size: 2.5rem;
		line-height: 1.2;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 1rem 0;
		text-align: center;
		color: var(--text-primary);
	}

	.name--small {
		font-size: 1.5rem;
		font-weight: 700;
	}

	.name--small a {
		color: inherit;
		text-decoration: none;
	}

	.back-to-home {
		margin: 3rem 0 0;
	}

	.back-to-home a {
		display: inline-block;
		padding: 0.5rem 1rem;
		border: 2px solid var(--border-color);
		border-radius: 8px;
		font-weight: 500;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.back-to-home a:hover {
		background-color: var(--accent);
		border-color: var(--accent);
		color: var(--accent-contrast);
	}

	@media (max-width: 720px) {
		.portrait {
			width: 250px;
			height: 200px;
		}

		.portrait--small {
			width: 200px;
			height: 160px;
		}

		.name {
			font-size: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portrait,
		.back-to-home a {
			transition: none;
		}
	}
</style>
