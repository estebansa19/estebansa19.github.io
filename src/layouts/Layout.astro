---
import HeaderLink from '../components/HeaderLink.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';

export interface Props {
  title: string;
  home?: boolean;
}

const { title, home = false } = Astro.props;
const name = 'Esteban Saldarriaga Alzate';
export const siteTitle = "Esteban's Website";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" />
    <meta name="description" content="Esteban's personal website" />

    <!-- Theme script - must run before any content renders -->
    <script is:inline>
      // Immediately apply stored theme to prevent flash
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    {home && (
      <link rel="preload" as="image" href="/images/profile.jpg" />
    )}
    <meta
      property="og:image"
      content={`https://og-image.vercel.app/${encodeURI(
        siteTitle
      )}.png?theme=light&md=0&fontSize=75px&images=https%3A%2F%2Fassets.vercel.com%2Fimage%2Fupload%2Ffront%2Fassets%2Fdesign%2Fnextjs-black-logo.svg`}
    />
    <meta name="og:title" content={siteTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <Header />

    <div class="container">
      <header class="profile-header">
        {home ? (
          <>
            <img
              src="/images/profile.jpg"
              class="borderCircle"
              alt="Profile image"
              loading="eager"
              fetchpriority="high"
              width="300"
              height="250"

            />
            <h1 class="heading2Xl">{name}</h1>
          </>
        ) : (
          <>
            <a href="/">
              <img
                src="/images/profile-small.jpg"
                class="borderCircle small"
                alt="Profile image"
                loading="eager"
                fetchpriority="high"
                width="250"
                height="200"
              />
            </a>
            <h2 class="headingLg">
              <a href="/" class="colorInherit">
                {name}
              </a>
            </h2>
          </>
        )}
      </header>
      <main>
        <slot />
      </main>
      {!home && (
        <div class="backToHome">
          <a href="/">← Back to home</a>
        </div>
      )}
    </div>
  </body>
</html>

<style>
  /* Navbar styles */
  .navbar {
    margin: 0;
    padding: 0 1em;
    background: var(--navbar-bg);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 8px var(--navbar-shadow);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border-color);
  }

  .navbar h2 {
    margin: 0;
    font-size: 1em;
  }

  .navbar h2 a,
  .navbar h2 a.active {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
  }

  .navbar nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar nav a {
    padding: 1em 0.5em;
    color: var(--text-primary);
    border-bottom: 4px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .navbar nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
    color: var(--accent);
  }

  .navbar nav a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .social-links,
  .social-links a {
    display: flex;
  }

  .internal-links {
    display: flex;
  }

  /* Profile header styles */
  .container {
    max-width: 36rem;
    padding: 0 1rem;
    margin: 3rem auto 6rem;
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .backToHome {
    margin: 3rem 0 0;
  }

  .backToHome a {
    color: var(--link-color);
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .backToHome a:hover {
    background-color: var(--accent);
    color: white;
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .heading2Xl {
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.05rem;
    margin: 1rem 0;
    text-align: center;
    color: var(--text-primary);
  }

  .headingLg {
    font-size: 1.5rem;
    line-height: 1.4;
    margin: 1rem 0;
    color: var(--text-primary);
  }

  .headingMd {
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .borderCircle {
    width: 300px;
    height: 250px;
    display: block;
    object-fit: cover;
    object-position: center top;
    /* Override global img styles */
    max-width: none !important;
    border: 4px solid var(--border-color);
    border-radius: 12px;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .borderCircle:hover {
    border-color: var(--accent);
    transform: scale(1.02);
  }

  .borderCircle.small {
    width: 250px;
    height: 200px;
  }

  .colorInherit {
    color: inherit;
    text-decoration: none;
  }

  .padding1px {
    padding-top: 1px;
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .listItem {
    margin: 0 0 1.25rem;
    padding: 1rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .listItem:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--shadow-light);
  }

  .lightText {
    color: var(--text-muted);
  }

  @media (max-width: 720px) {
    .social-links {
      display: none;
    }

    .borderCircle {
      width: 250px;
      height: 200px;
    }

    .borderCircle.small {
      width: 200px;
      height: 160px;
    }
  }
</style>
