---
/** Social icon row, shared by the header and the footer. Glyphs come from the page sprite. */
import { SOCIALS } from '../consts';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['social-links', className]}>
	{
		SOCIALS.map((social) => (
			<a href={social.href} target="_blank" rel="me noopener noreferrer">
				<span class="sr-only">{`Esteban on ${social.label}`}</span>
				<svg width="24" height="24" aria-hidden="true">
					<use href={`#icon-${social.label.toLowerCase()}`} />
				</svg>
			</a>
		))
	}
</div>

<style>
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		border-radius: 8px;
		color: var(--text-secondary);
		transition:
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.social-links a:hover {
		color: var(--accent);
		background-color: var(--surface-hover);
	}
</style>
