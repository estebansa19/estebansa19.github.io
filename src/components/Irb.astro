---
/**
 * An interactive (and entirely fake) irb session about me. The first exchange
 * is rendered on the server so the box reads fine without JavaScript; the
 * interpreter itself lives in src/scripts/irb.ts.
 */
import type { IrbData } from '../scripts/irb';

interface Props {
	data: IrbData;
}

const { data } = Astro.props;

const SUGGESTIONS = [
	'esteban.stack',
	'esteban.jobs.map(&:company).uniq',
	'esteban.current_job',
	'esteban.beer?',
	'esteban.hire!',
	'help',
];

const seedReturn = `=> #<Engineer name: ${JSON.stringify(data.name)}, role: ${JSON.stringify(data.role)}, location: ${JSON.stringify(data.location)}, favorite_language: "Ruby">`;
---

<section class="irb" aria-labelledby="irb-title">
	<div class="irb-window">
		<div class="irb-bar">
			<span class="irb-lights" aria-hidden="true"><i></i><i></i><i></i></span>
			<h2 id="irb-title" class="irb-title">irb — esteban.rb</h2>
		</div>

		<div class="irb-screen" data-irb-screen>
			<div class="irb-log" data-irb-log role="log" aria-live="polite" aria-relevant="additions">
				<p class="line line--input"><span class="prompt">irb(main):001&gt;</span> esteban = Engineer.find_by(country: "CO")</p>
				<p class="line line--ret">{seedReturn}</p>
			</div>
			<form class="irb-form" data-irb-form autocomplete="off">
				<label class="prompt" for="irb-input" data-irb-prompt>irb(main):002&gt;</label>
				<input
					id="irb-input"
					class="irb-input"
					data-irb-input
					type="text"
					spellcheck="false"
					autocapitalize="off"
					autocomplete="off"
					enterkeyhint="send"
					aria-describedby="irb-try"
					placeholder="try: help"
				/>
			</form>
		</div>
	</div>

	<div class="irb-try" id="irb-try">
		<span class="irb-try-label">try</span>
		{
			SUGGESTIONS.map((cmd) => (
				<button type="button" class="irb-chip" data-irb-run={cmd}>
					{cmd}
				</button>
			))
		}
	</div>

	<script is:inline type="application/json" data-irb-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</section>

<script>
	import { createIrb, type IrbData, type Output } from '../scripts/irb';

	const root = document.querySelector<HTMLElement>('.irb');
	const dataEl = root?.querySelector('[data-irb-data]');

	if (root && dataEl?.textContent) {
		const irb = createIrb(JSON.parse(dataEl.textContent) as IrbData);
		const screen = root.querySelector<HTMLElement>('[data-irb-screen]')!;
		const log = root.querySelector<HTMLElement>('[data-irb-log]')!;
		const form = root.querySelector<HTMLFormElement>('[data-irb-form]')!;
		const input = root.querySelector<HTMLInputElement>('[data-irb-input]')!;
		const promptEl = root.querySelector<HTMLElement>('[data-irb-prompt]')!;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let line = 2;
		const history: string[] = [];
		let cursor = 0;
		let typing = false;
		let finishTyping = () => {};

		const prompt = () => `irb(main):${String(line).padStart(3, '0')}>`;

		/** Escapes text and turns bare URLs into links. */
		function render(el: HTMLElement, text: string) {
			const parts = text.split(/(https?:\/\/[^\s"',\]}]+)/g);
			parts.forEach((part, i) => {
				if (i % 2) {
					const a = document.createElement('a');
					a.href = part;
					a.target = '_blank';
					a.rel = 'noopener noreferrer';
					a.textContent = part;
					el.append(a);
				} else if (part) {
					el.append(part);
				}
			});
		}

		function print(tone: Output['tone'] | 'input', text: string) {
			const p = document.createElement('p');
			p.className = `line line--${tone}`;
			if (tone === 'input') {
				const span = document.createElement('span');
				span.className = 'prompt';
				span.textContent = prompt();
				p.append(span, ' ', text);
			} else {
				render(p, text);
			}
			log.append(p);
		}

		function execute(source: string) {
			print('input', source);
			const result = irb.run(source, line);
			if (result === 'clear') {
				log.replaceChildren();
			} else {
				result.forEach(({ tone, text }) => print(tone, text));
			}
			if (source.trim()) {
				if (history.at(-1) !== source) history.push(source);
				line++;
			}
			cursor = history.length;
			promptEl.textContent = prompt();
			screen.scrollTop = screen.scrollHeight;
		}

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (typing) return finishTyping();
			const source = input.value;
			input.value = '';
			execute(source);
		});

		input.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
				if (!history.length) return;
				event.preventDefault();
				cursor = Math.max(0, Math.min(history.length, cursor + (event.key === 'ArrowUp' ? -1 : 1)));
				input.value = history[cursor] ?? '';
				input.setSelectionRange(input.value.length, input.value.length);
			} else if (event.key === 'Tab' && input.value && !event.shiftKey) {
				const { prefix, candidates } = irb.complete(input.value);
				if (!candidates.length) return;
				// Only hold focus in the box when there was something to complete.
				event.preventDefault();
				let shared = candidates[0];
				for (const c of candidates) while (!c.startsWith(shared)) shared = shared.slice(0, -1);
				input.value += shared.slice(prefix.length);
				if (candidates.length > 1 && shared === prefix) {
					print('note', candidates.join('  '));
					screen.scrollTop = screen.scrollHeight;
				}
			} else if (event.key === 'l' && event.ctrlKey) {
				event.preventDefault();
				log.replaceChildren();
			}
		});

		// Clicking anywhere on the screen focuses the prompt, unless selecting text or following a link.
		screen.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;
			if (!target.closest('a') && !window.getSelection()?.toString()) input.focus({ preventScroll: true });
		});

		root.querySelectorAll<HTMLButtonElement>('[data-irb-run]').forEach((button) => {
			button.addEventListener('click', async () => {
				if (typing) return;
				const cmd = button.dataset.irbRun!;
				if (!reduceMotion.matches && !document.hidden) {
					// Type it out, like someone is at the keyboard. Enter skips ahead.
					typing = true;
					let skip = false;
					finishTyping = () => (skip = true);
					input.value = '';
					for (const ch of cmd) {
						if (skip) break;
						input.value += ch;
						await new Promise((r) => setTimeout(r, 18 + Math.random() * 34));
					}
					if (!skip) await new Promise((r) => setTimeout(r, 120));
					typing = false;
				}
				input.value = '';
				execute(cmd);
			});
		});
	}
</script>

<style>
	.irb {
		margin: 0 0 3.5rem;
	}

	.irb-window {
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--code-bg);
		overflow: hidden;
		box-shadow: 0 1px 0 var(--line), 0 18px 40px -28px oklch(0.3 0.1 25 / 0.45);
	}

	.irb-bar {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		padding: 0.5rem 0.875rem;
		border-bottom: 1px solid var(--line);
		background: var(--bg);
	}

	.irb-lights {
		display: flex;
		gap: 6px;
	}

	.irb-lights i {
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: var(--line);
	}

	.irb-lights i:first-child {
		background: var(--accent);
	}

	.irb-title {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--muted);
	}

	.irb-screen {
		max-height: 22rem;
		overflow-y: auto;
		padding: 0.875rem 1rem 0.75rem;
		font-size: 0.8125rem;
		line-height: 1.65;
		cursor: text;
		scrollbar-width: thin;
		/* `=>` must stay two characters, not the font's arrow ligature. */
		font-variant-ligatures: none;
	}

	/* Log lines are appended by the script, so they carry no scoping attribute. */
	.irb-log :global(.line) {
		margin: 0;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.irb-log :global(.line--input) {
		color: var(--text);
	}

	.irb-log :global(.line--input:not(:first-child)) {
		margin-top: 0.375rem;
	}

	.irb-log :global(.line--ret) {
		color: var(--muted);
	}

	.irb-log :global(.line--note) {
		color: var(--muted);
		font-style: italic;
	}

	.irb-log :global(.line--err) {
		color: var(--accent);
	}

	.irb-log :global(.line a) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.irb-screen :global(.prompt) {
		color: var(--accent);
		user-select: none;
	}

	.irb-form {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin-top: 0.375rem;
	}

	.irb-form .prompt {
		flex-shrink: 0;
	}

	.irb-input {
		flex: 1;
		min-width: 0;
		padding: 0;
		border: 0;
		background: none;
		color: var(--text);
		font: inherit;
		caret-color: var(--accent);
		outline: none;
	}

	.irb-input::placeholder {
		color: var(--muted);
		opacity: 0.6;
	}

	.irb-window:focus-within {
		border-color: color-mix(in oklch, var(--accent) 55%, var(--line));
	}

	.irb-try {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem 0.5rem;
		margin-top: 0.75rem;
	}

	.irb-try-label {
		font-size: 0.6875rem;
		color: var(--muted);
		margin-right: 0.125rem;
	}

	.irb-chip {
		padding: 0.25rem 0.5rem;
		border: 1px dashed var(--line);
		border-radius: 3px;
		background: none;
		color: var(--text);
		font: inherit;
		font-size: 0.6875rem;
		cursor: pointer;
		transition:
			border-color 0.18s ease,
			color 0.18s ease;
	}

	.irb-chip:hover {
		border-color: var(--accent);
		border-style: solid;
		color: var(--accent);
	}

	@media (pointer: coarse) {
		/* Below 16px, iOS zooms the page when the field takes focus. */
		.irb-input {
			font-size: 16px;
		}
	}

	@media (max-width: 720px) {
		.irb-screen {
			max-height: 18rem;
			padding: 0.75rem;
			font-size: 0.75rem;
		}
	}
</style>
