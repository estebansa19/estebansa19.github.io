---
import { SOCIALS, AUTHOR } from '../consts';
import { getPosts } from '../utils/content';

const year = new Date().getFullYear();
const hasPosts = (await getPosts({ includeDrafts: false })).length > 0;
---

<footer>
	<div class="inner">
		<div class="links">
			{
				SOCIALS.map((social) => (
					<a href={social.href} target="_blank" rel="me noopener noreferrer">
						{social.label.toLowerCase()}
					</a>
				))
			}
			{hasPosts && <a href="/rss.xml">rss</a>}
		</div>
		<p class="copyright">&copy; {year} {AUTHOR.name}</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		border-top: 1px solid var(--line);
	}

	.inner {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 1.75rem 2rem;
	}

	.links {
		display: flex;
		gap: 1.5rem;
		font-size: 0.8125rem;
	}

	.copyright {
		margin: 0;
		font-size: 0.75rem;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.inner {
			flex-direction: column;
			gap: 1rem;
			padding: 1.75rem 1.25rem;
		}
	}
</style>
