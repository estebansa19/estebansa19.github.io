---
/**
 * Renders a date as a machine-readable <time>. Accepts the literal `'present'`
 * used by the current job, which has no end date to mark up.
 */
import { monthYear, toISODate } from '../utils/date';

interface Props {
  date: Date | 'present';
  /** `long` → "January 5, 2025"; `short` → "Jan 2025". */
  format?: 'long' | 'short';
}

const { date, format = 'long' } = Astro.props;

const FORMATTERS = {
  long: new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }),
  short: monthYear,
};
---

{
  date === 'present' ? (
    <span>Present</span>
  ) : (
    <time datetime={toISODate(date)}>{FORMATTERS[format].format(date)}</time>
  )
}
