---
interface Props {
  href: string;
  /** Extra top-level sections that mark this link active, e.g. `jobs`. */
  sections?: string[];
}

const { href, sections = [] } = Astro.props;
const { pathname } = Astro.url;
const [section = ''] = pathname.match(/[^\/]+/g) ?? [];
const ownSection = href.replace(/^\/|\/$/g, '');
const isCurrentPage = href === pathname;
const isActive = isCurrentPage || ownSection === section || sections.includes(section);
---

<a
  href={href}
  class:list={{ active: isActive }}
  aria-current={isCurrentPage ? 'page' : isActive ? 'true' : undefined}
>
  <slot />
</a>

<style>
  a {
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease;
  }

  a:hover {
    color: var(--text);
    text-decoration: none;
  }

  a.active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
</style>
