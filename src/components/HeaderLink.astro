---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  /** Other top-level sections that belong to this link, e.g. `jobs` for the resume. */
  sections?: string[];
};

const { href, sections = [], class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/').replace(/\/{2,}/g, '/');
const [section = ''] = pathname.match(/[^\/]+/g) ?? [];
const ownSection = String(href).replace(/^\/|\/$/g, '');
const isCurrentPage = href === pathname;
const isActive = isCurrentPage || ownSection === section || sections.includes(section);
---

<a
  href={href}
  class:list={[className, { active: isActive }]}
  aria-current={isCurrentPage ? 'page' : isActive ? 'true' : undefined}
  {...props}
>
  <slot />
</a>

<style>
  a {
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease;
  }

  a:hover {
    color: var(--text);
    text-decoration: none;
  }

  a.active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
</style>
