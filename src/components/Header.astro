---
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
import { getPosts } from '../utils/content';

// The blog only appears in the nav once there is something to read.
const hasPosts = (await getPosts({ includeDrafts: false })).length > 0;
---

<header class="navbar">
	<nav aria-label="Main">
		<a href="/" class="brand">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">Resume</HeaderLink>
			{hasPosts && <HeaderLink href="/blog">Blog</HeaderLink>}
		</div>
		<div class="nav-actions">
			<SocialLinks class="header-socials" />
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1em;
		background: var(--navbar-bg);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border-color);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
		text-decoration: none;
	}

	.internal-links {
		display: flex;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	@media (max-width: 720px) {
		.navbar :global(.header-socials) {
			display: none;
		}
	}
</style>
